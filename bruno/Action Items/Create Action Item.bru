meta {
  name: Create Action Item
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/tdvsp_actionitems
  body: json
  auth: inherit
}

headers {
  Prefer: return=representation
}

body:json {
  {
    "tdvsp_name": "New Action Item",
    "tdvsp_date": "2026-03-20",
    "tdvsp_description": "Description here",
    "tdvsp_taskstatus": 468510000,
    "tdvsp_priority": 468510000,
    "tdvsp_tasktype": 468510001,
    "tdvsp_Customer@odata.bind": "/accounts({{accountId}})"
  }
}

docs {
  ## Task Status Values
  - 468510000: Recognized/Pondering
  - 468510001: In Progress
  - 468510002: Pending Communication
  - 468510003: On Hold
  - 468510004: Wrapping Up
  - 468510005: Complete

  ## Priority Values
  - 468510000: Low
  - 468510001: Eh... Get to it when you can
  - 468510002: Top priority
  - 468510003: High

  ## Task Type Values
  - 468510000: Personal
  - 468510001: Work
}
